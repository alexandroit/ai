{
  "name": "@stackline/ai-rag-postgres",
  "version": "0.0.4",
  "description": "PostgreSQL read-only RAG retriever for Stackline AI.",
  "license": "MIT",
  "author": "Stackline",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://alexandro.net/docs/ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/ai.git",
    "directory": "packages/rag-postgres"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/ai/issues"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "DEPENDENCY_REVIEW.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean --external @stackline/ai && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@stackline/ai": "workspace:*",
    "@types/pg": "npm:@stackline/types-pg@1.0.0",
    "pg": "npm:@stackline/pg@1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "stackline",
    "stackline-ai",
    "ai",
    "artificial-intelligence",
    "generative-ai",
    "rag",
    "retrieval-augmented-generation",
    "context-retrieval",
    "retriever",
    "database-retriever",
    "postgres",
    "postgresql",
    "pg",
    "database",
    "sql",
    "readonly-sql",
    "readonly",
    "llm",
    "backend",
    "knowledge-base",
    "typescript",
    "javascript"
  ]
}
